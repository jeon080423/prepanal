# 로컬 개발용 secrets 템플릿.
# 이 파일을 복사해 .streamlit/secrets.toml 로 만든 뒤 실제 키를 입력하세요.
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
# secrets.toml은 .gitignore에 포함되어 있어 Git에 올라가지 않습니다.
# Streamlit Cloud에서는 앱 설정의 Secrets에 아래 키를 등록하세요.

GEMINI_API_KEY = "여기에_Gemini_API_키_입력"
OPENAI_API_KEY = "여기에_OpenAI_API_키_입력"

# --- Google Sheets 프로젝트 저장 (선택사항) ---
# 설정하지 않으면 로컬 파일에 저장 (리부트 시 삭제됨)
# GOOGLE_SERVICE_ACCOUNT: 서비스 계정 JSON 전체를 한 줄 문자열로
# PROJECTS_SHEET_ID: 스프레드시트 URL의 /d/ 다음 부분
#GOOGLE_SERVICE_ACCOUNT='{"type": "service_account", ...}'
#PROJECTS_SHEET_ID="1abc..."
